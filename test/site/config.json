{
	"baseURL": "https://example.org/",
	"title": "Fixture Blog",
	"disableKinds": [
		"RSS"
	],
	"permalinks": {
		"notes": "/:slug/"
	},
	"taxonomies": {
		"category": "categories"
	},
	"params": {
		"itunes_description": "A blog that should not show this line.",
		"author": {
			"avatar": "https://example.org/avatar.jpg"
		}
	},
	"markup": {
		"goldmark": {
			"renderer": {
				"unsafe": true
			}
		}
	},
	"enableRobotsTXT": true,
	"paginate": 7,
	"outputs": {
		"home": [
			"HTML",
			"ArchiveHTML",
			"PhotosHTML"
		]
	},
	"pagination": {
		"pagerSize": 7
	}
}
